{
  "name": "ac-hardhat-template-v2",
  "version": "1.0.0",
  "description": "Modern Hardhat v3 template with TypeScript, Ethers.js, and Ignition",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat test --coverage",
    "test:gas": "hardhat test --gas-stats",
    "node": "hardhat node",
    "use:day1": "node scripts/switchNetworkMode.ts day1",
    "use:day86400": "node scripts/switchNetworkMode.ts day86400",
    "deploy:local": "hardhat --network localhost ignition deploy ignition/modules/BankDeposit.ts",
    "deploy:local:day1": "hardhat --network localhost ignition deploy ignition/modules/BankDeposit.ts --parameters ignition/params/sepolia-day1.json --reset",
    "deploy:sepolia": "hardhat --network sepolia ignition deploy ignition/modules/BankDeposit.ts",
    "deploy:day1": "hardhat --network sepolia ignition deploy ignition/modules/BankDeposit.ts --parameters ignition/params/sepolia-day1.json --deployment-id sepolia-day1",
    "deploy:day86400": "hardhat --network sepolia ignition deploy ignition/modules/BankDeposit.ts --parameters ignition/params/sepolia-day86400.json --deployment-id sepolia-day86400",
    "verify:time": "hardhat run scripts/verifyTimeParams.ts",
    "check:sepolia": "hardhat --network sepolia run scripts/verifyTimeParams.ts",
    "check:local": "hardhat --network localhost run scripts/verifyTimeParams.ts",
    "seed": "hardhat --network localhost run scripts/seed.ts",
    "bot": "hardhat --network localhost run scripts/bot.ts",
    "start:day1": "hardhat --network sepolia run scripts/bot.ts",
    "start:day86400": "hardhat --network sepolia run scripts/bot.ts",
    "interact": "hardhat --network localhost run scripts/interact.ts",
    "timetravel": "hardhat --network localhost run scripts/timeTravel.ts",
    "withdraw": "hardhat --network localhost run scripts/withdraw.ts",
    "export:frontend": "hardhat run scripts/exportFrontend.ts"
  },
  "keywords": [
    "hardhat",
    "ethereum",
    "smart-contracts",
    "template"
  ],
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@openzeppelin/hardhat-upgrades": "^4.1.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "chai": "^6.3.0",
    "dotenv": "^18.0.8",
    "ethers": "^6.17.0",
    "hardhat": "^3.19.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  }
}
